# Copy to scripts/prod.env (gitignored) and fill in. aws-bootstrap.sh feeds
# these to the App Runner service as runtime environment variables.
#
# For real secrets, prefer AWS Secrets Manager over plaintext here; this file is
# the quick path to a working service. S3_BUCKET must match the one in
# aws-bootstrap.sh.
# Paste your managed Postgres connection string (e.g. from Neon — neon.tech).
# Keep CREATE_RDS unset/false to use this. Set CREATE_RDS=true only to have the
# bootstrap script provision RDS instead, in which case it overwrites this line.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/cats?sslmode=require
SECRET_KEY=change-me-run-secrets-token_hex-32
# 30 days: max time a device can stay closed before its session lapses. The app
# rotates its token on every launch via /auth/refresh, so active users never hit it.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Comma-separated OAuth client IDs accepted by the API. Google needs every
# client that can mint a token for this app (Android signing variants, iOS and
# optionally Web). Do not leave these blank in production.
GOOGLE_CLIENT_ID=810809531248-84q4s1tq200ve9cclmr4p7qt64ug29u5.apps.googleusercontent.com,810809531248-do5nq78e3v9avhp0glotqmvsqko90bpf.apps.googleusercontent.com
APPLE_CLIENT_ID=uk.amicitia.catapp
S3_BUCKET=cats-media-prod
S3_REGION=us-east-1
MEDIA_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-haiku-4-5
