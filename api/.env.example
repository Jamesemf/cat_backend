DATABASE_URL=sqlite:///./cats.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production: with a non-SQLite DATABASE_URL the app refuses to boot
# unless this is a strong (>=32 char) value — never the default below.
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed via CORS. "*" is safe here because the
# API authenticates with Bearer tokens (no cookies/credentials). Lock it down for
# the web build if you prefer, e.g. https://app.catapp.uk
CORS_ALLOW_ORIGINS=*

# OAuth client IDs. When set, Apple/Google sign-in verifies each token's audience
# against these, rejecting tokens minted for a different app (prevents account
# takeover by token substitution). Leave blank in local dev (verification is
# skipped with a warning).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Leave S3_BUCKET empty to store media on local disk (dev). Set it to enable S3.
S3_BUCKET=
S3_REGION=us-east-1
# Public base for media URLs (e.g. a CloudFront domain). Empty => presigned S3
# URLs in prod, or the API's /uploads route in local dev.
MEDIA_BASE_URL=

# Anthropic API key for Claude Haiku vision recognition.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Haiku 4.5 is the default — the vision task is closed-vocabulary classification
# (enum-constrained tool call), well within Haiku's range at ~1/3 the cost of
# Sonnet. Swap to claude-sonnet-4-6 if breed accuracy needs a bump. Note:
# claude-sonnet-5 / claude-opus-4-7+ reject the temperature param used in
# vision.py and cost more per image (high-res vision) — don't use those here
# without updating the call sites.
ANTHROPIC_MODEL=claude-haiku-4-5
